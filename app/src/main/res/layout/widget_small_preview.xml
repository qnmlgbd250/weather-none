<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="@drawable/widget_rounded_bg"
    android:clipToOutline="true"
    android:clipChildren="true">

    <!-- Background fills the entire widget -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_preview_bg"
        android:contentDescription="@null" />

    <!-- Row 1: Top - Temperature left, Icon+City right -->
    <LinearLayout
        android:id="@+id/widget_top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Left: Large temperature -->
        <TextView
            android:id="@+id/widget_temp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="42sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="26°"
            android:translationY="4dp" />

        <!-- Right: Icon on top, City below -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_preview_sun"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/widget_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EEFFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="当前位置" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Bottom forecast row - Now / +1h / +2h -->
    <LinearLayout
        android:id="@+id/widget_forecast_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- Now -->
        <LinearLayout
            android:id="@+id/widget_forecast_now"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/widget_time_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BBFFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="现在" />

            <ImageView
                android:id="@+id/widget_icon_now"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_preview_sun"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_temp_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="26°" />
        </LinearLayout>

        <!-- +1 hour -->
        <LinearLayout
            android:id="@+id/widget_forecast_1h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/widget_time_1h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BBFFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="15:00" />

            <ImageView
                android:id="@+id/widget_icon_1h"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_preview_sun"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_temp_1h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="27°" />
        </LinearLayout>

        <!-- +2 hours -->
        <LinearLayout
            android:id="@+id/widget_forecast_2h"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/widget_time_2h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BBFFFFFF"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="16:00" />

            <ImageView
                android:id="@+id/widget_icon_2h"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_preview_sun"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_temp_2h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="25°" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
