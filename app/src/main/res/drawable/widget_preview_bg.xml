<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#E1A7B8C7"
                android:endColor="#DDD7E8F2"
                android:startColor="#E08AA6BA" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#78FFFFFF"
                android:endColor="#46FFFFFF"
                android:startColor="#8CFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#12000000"
                android:startColor="#00000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
